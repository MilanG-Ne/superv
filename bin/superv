#!/usr/bin/env python3
"""Launcher for SuperV. Finds the `superv` package next to this script
(source checkout), in ../lib/superv (installed), or on sys.path."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for candidate in (os.path.join(here, ".."), os.path.join(here, "..", "lib", "superv")):
    if os.path.isfile(os.path.join(candidate, "superv", "__init__.py")):
        sys.path.insert(0, os.path.abspath(candidate))
        break
# Shortcuts and autostart entries point at this exact file.
os.environ.setdefault("SUPERV_LAUNCHER", os.path.abspath(__file__))

from superv.__main__ import main  # noqa: E402

sys.exit(main())
